{
  "name": "dsh-cot-flow",
  "version": "0.1.0",
  "description": "Streaming-friendly rendering for expanded reasoning (thinking) text: incremental segmentation, finalized-paragraph memoization, and light typographic clean-up.",
  "license": "MIT",
  "author": "yutaosheng004-bit (https://github.com/yutaosheng004-bit)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yutaosheng004-bit/dsh-cot-flow.git"
  },
  "homepage": "https://github.com/yutaosheng004-bit/dsh-cot-flow#readme",
  "bugs": {
    "url": "https://github.com/yutaosheng004-bit/dsh-cot-flow/issues"
  },
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "reasoning",
    "thinking",
    "performance"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/scan.test.mjs && node test/render.test.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "engines": {
    "node": ">=22.13.0",
    "dsh": ">=0.1.7-0 <0.3.0-0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs",
    "test"
  ]
}